# ─── Server ───
PORT=4000
NODE_ENV=production

# ─── Execution Mode ───
# "docker" = Secure Docker containers (recommended)
# "direct" = Direct child_process (no Docker required, less secure)
EXECUTION_MODE=docker

# ─── Performance Tuning ───
MAX_CONCURRENT_JOBS=4        # Max jobs running at same time
MAX_QUEUE_SIZE=50            # Max jobs waiting in queue
MAX_PARALLEL_TESTS=5         # Max tests per job running in parallel
JOB_TIMEOUT_MS=60000         # Auto-kill jobs after 60s

# ─── Execution Limits ───
DEFAULT_TIME_MS=10000        # Per-test timeout (10s)
DEFAULT_MEMORY_MB=256        # Memory limit per container
DEFAULT_CPU=0.5              # CPU limit per container
MAX_OUTPUT_BYTES=10240       # Truncate stdout/stderr at 10KB
MAX_CODE_LENGTH=51200        # Max code size (50KB)
MAX_TESTS=20                 # Max test cases per request

# ─── Docker Images ───
DOCKER_IMAGE_PYTHON=proctorx-python
DOCKER_IMAGE_CPP=proctorx-cpp
DOCKER_IMAGE_JAVA=proctorx-java
DOCKER_IMAGE_NODE=proctorx-node

# ─── Temp Directory ───
TMP_ROOT=/tmp/proctorx

# ─── CORS ───
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://proctorxofficial.vercel.app

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW_MS=60000   # 1 minute window
RATE_LIMIT_MAX=10            # Max 10 requests per window per IP
